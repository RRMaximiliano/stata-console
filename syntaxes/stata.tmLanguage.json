{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Stata",
  "scopeName": "source.stata",
  "patterns": [
    { "include": "#semicolon" },
    { "include": "#directives" },
    { "include": "#mata" },
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#macros" },
    { "include": "#numbers" },
    { "include": "#functions" },
    { "include": "#control" },
    { "include": "#keywords" },
    { "include": "#commands" },
    { "include": "#operators" }
  ],
  "repository": {
    "slash-comments": {
      "patterns": [
        {
          "name": "comment.line.triple-slash.stata",
          "match": "(?<!\\S)///.*$"
        },
        {
          "name": "comment.line.double-slash.stata",
          "match": "(?<!\\S)//(?!/).*$"
        }
      ]
    },
    "semicolon": {
      "name": "meta.delimited.stata",
      "begin": "^\\s*(#delimit)\\s+(;)\\s*(?://.*)?$",
      "beginCaptures": {
        "0": {
          "name": "meta.preprocessor.stata"
        }
      },
      "end": "^\\s*(#delimit)\\s+(cr)\\b.*$",
      "endCaptures": {
        "0": {
          "name": "meta.preprocessor.stata"
        }
      },
      "patterns": [
        {
          "include": "#block-comment"
        },
        {
          "include": "#slash-comments"
        },
        {
          "name": "comment.line.star.stata",
          "begin": "\\*",
          "end": ";"
        },
        {
          "name": "meta.statement.stata",
          "begin": "(?=\\S)",
          "end": ";",
          "patterns": [
            {
              "include": "#block-comment"
            },
            {
              "include": "#slash-comments"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#macros"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#functions"
            },
            {
              "include": "#control"
            },
            {
              "include": "#keywords"
            },
            {
              "include": "#commands"
            },
            {
              "include": "#operators"
            }
          ]
        }
      ]
    },
    "block-comment": {
      "name": "comment.block.stata",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [
        {
          "include": "#block-comment"
        }
      ]
    },
    "compound-string": {
      "name": "string.quoted.compound.stata",
      "begin": "`\"",
      "end": "\"'",
      "patterns": [
        {
          "include": "#compound-string"
        },
        {
          "include": "#macros"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "meta.preprocessor.stata",
          "match": "^\\s*#delimit\\s+(?:;|cr)\\s*$"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.string.stata",
          "match": "\\b(?:str(?:len|lower|upper|trim|itrim|rtrim|ltrim|pos|rpos|reverse|match|toname)|substr|subinstr|subinword|regexm|regexr|regexs|ustr\\w+|real|string|strofreal|char|uchar|word|wordcount|trim|lower|upper|length|strpos|inlist|inrange|missing|cond)(?=\\s*\\()"
        }
      ]
    },
    "mata": {
      "name": "meta.embedded.block.mata",
      "begin": "^\\s*(mata)\\s*:?\\s*(?://.*)?$",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.stata"
        }
      },
      "end": "^\\s*(end)\\b",
      "endCaptures": {
        "1": {
          "name": "keyword.control.stata"
        }
      },
      "patterns": [
        {
          "include": "#block-comment"
        },
        {
          "name": "comment.line.double-slash.mata",
          "match": "//.*$"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#macros"
        },
        {
          "include": "#numbers"
        },
        {
          "name": "storage.type.mata",
          "match": "\\b(?:real|complex|string|scalar|vector|matrix|rowvector|colvector|void|struct|pointer|transmorphic|external)\\b"
        },
        {
          "name": "keyword.control.mata",
          "match": "\\b(?:if|else|for|while|do|break|continue|return)\\b"
        },
        {
          "name": "support.function.mata",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
        },
        {
          "include": "#operators"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "include": "#block-comment"
        },
        {
          "name": "comment.line.triple-slash.stata",
          "match": "(?<!\\S)///.*$"
        },
        {
          "name": "comment.line.double-slash.stata",
          "match": "(?<!\\S)//(?!/).*$"
        },
        {
          "name": "comment.line.star.stata",
          "match": "^\\s*\\*.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "include": "#compound-string"
        },
        {
          "name": "string.quoted.double.stata",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "include": "#macros"
            }
          ]
        }
      ]
    },
    "macros": {
      "patterns": [
        {
          "name": "variable.other.local.stata",
          "begin": "`(?!\")",
          "end": "'|$",
          "patterns": [
            {
              "include": "#macros"
            }
          ]
        },
        {
          "name": "variable.other.global.stata",
          "match": "\\$\\{[a-zA-Z_][a-zA-Z0-9_]*\\}|\\$[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.stata",
          "match": "(?<![\\w.])(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?!\\w)"
        },
        {
          "name": "constant.language.missing.stata",
          "match": "(?<![\\w.])\\.[a-z]?(?!\\w)"
        }
      ]
    },
    "control": {
      "patterns": [
        {
          "name": "keyword.control.stata",
          "match": "\\b(if|else|while|foreach|forvalues|in|of|local|global|program|end|define|exit|continue|break|return|mata|version|qui|quietly|cap|capture|noi|noisily|preserve|restore|tempvar|tempname|tempfile|args|syntax|confirm|gettoken|tokenize|timer|set)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.other.stata",
          "match": "\\b(using|replace|clear|all|varlist|newlist|string|numeric|integer|matrix|scalar|var|by|bys|bysort|sort|xi|svy|mi|st|xt|me|sem|gsem|bayesmh)\\b"
        },
        {
          "name": "support.type.stata",
          "match": "\\b(byte|int|long|float|double|str[0-9]*|strL)\\b"
        }
      ]
    },
    "commands": {
      "patterns": [
        {
          "name": "support.function.data.stata",
          "match": "\\b(use|save|import|export|insheet|outsheet|infile|infix|merge|append|reshape|collapse|contract|fillin|cross|joinby|stack|xpose|compress|recast|destring|tostring|encode|decode)\\b"
        },
        {
          "name": "support.function.manipulation.stata",
          "match": "\\b(gen|generate|replace|drop|keep|rename|recode|label|order|sort|gsort|duplicates|isid|levelsof|egen|bysort|assert|count|distinct|fre)\\b"
        },
        {
          "name": "support.function.statistics.stata",
          "match": "\\b(regress|reg|logit|logistic|probit|ologit|oprobit|mlogit|poisson|nbreg|tobit|truncreg|heckman|ivregress|ivreg2|xtreg|xtivreg|xtlogit|xtpoisson|areg|reghdfe|ivreghdfe|didregress|diff_in_diff|rdrobust|synth|binscatter|lpoly|lowess|qreg|rreg|sureg|sem|gsem|mixed|melogit|bayesmh|bayes|bootstrap|jackknife|permute|simulate|power|sampsi)\\b"
        },
        {
          "name": "support.function.descriptive.stata",
          "match": "\\b(summarize|su|sum|tabulate|tab|table|describe|des|codebook|inspect|list|browse|br|edit|ed|display|di|correlate|cor|pwcorr|mean|proportion|ratio|total|ci|centile|pctile|xtile|histogram|kdensity|stem|symplot|qnorm|pnorm|gladder|ladder)\\b"
        },
        {
          "name": "support.function.testing.stata",
          "match": "\\b(test|testnl|lincom|nlcom|margins|marginsplot|contrast|pwcompare|predict|estat|fitstat|lrtest|hausman|overid|weakiv|ivendog|anova|oneway|ttest|ranksum|signrank|kwallis|ksmirnov|swilk|sktest|vif|hettest|bpagan|dwstat|durbina|actest|archlm|ovtest|linktest)\\b"
        },
        {
          "name": "support.function.graphics.stata",
          "match": "\\b(graph|twoway|scatter|line|connected|area|bar|dot|box|pie|histogram|kdensity|qnorm|pnorm|qqplot|spike|dropline|rarea|rbar|rcap|rline|rscatter|rcapsym|function|matrix|combine|hbar|scheme|grstyle|coefplot|plotmatrix|maptile|spmap|grmap)\\b"
        },
        {
          "name": "support.function.io.stata",
          "match": "\\b(do|run|include|sysuse|webuse|bcuse|freduse|wbopendata|cd|dir|ls|copy|erase|mkdir|rmdir|type|cat|file|filefilter|log|cmdlog|translate|set|query|adopath|ssc|net|ado|which|findfile|mata)\\b"
        },
        {
          "name": "support.function.estimation.stata",
          "match": "\\b(eststo|esttab|estout|estadd|outreg2|ftools|gtools|gcollapse|gstats|estimates|ereturn|return|matrix|scalar|constraint|ml|gmm|nlsur|frontier|stcox|streg|stset|stdes|stsum|sts|stcurve|stpower|ltable|ctset|snapshot)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.factor.stata",
          "match": "\\b(?:i|c|o|b|bn|ibn|ib[0-9]+|ib\\((?:first|last|freq|[0-9]+)\\))\\.|##?"
        },
        {
          "name": "keyword.operator.comparison.stata",
          "match": "==|!=|~=|>=|<=|>|<"
        },
        {
          "name": "keyword.operator.logical.stata",
          "match": "&{1,2}|\\|{1,2}|!|~"
        },
        {
          "name": "keyword.operator.arithmetic.stata",
          "match": "\\+|-|\\*|/|\\^"
        },
        {
          "name": "keyword.operator.assignment.stata",
          "match": "="
        }
      ]
    }
  }
}
