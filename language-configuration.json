{
  "comments": {
    "lineComment": "//",
    "blockComment": [
      "/*",
      "*/"
    ]
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "`",
      "'"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "`\"",
      "close": "\"'",
      "notIn": [
        "comment"
      ]
    },
    {
      "open": "{",
      "close": "}",
      "notIn": [
        "comment"
      ]
    },
    {
      "open": "(",
      "close": ")",
      "notIn": [
        "comment"
      ]
    },
    {
      "open": "[",
      "close": "]",
      "notIn": [
        "comment"
      ]
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "`",
      "close": "'",
      "notIn": [
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    {
      "open": "`\"",
      "close": "\"'"
    },
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "\"",
      "close": "\""
    },
    {
      "open": "`",
      "close": "'"
    }
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(?:\\*\\*#+\\s*(?!endregion\\b)\\S|(?:cap(?:ture)?\\s+)?pr(?:ogram)?\\s+(?!(?:drop|dir|list)\\b)|(?:foreach|forvalues|while|if|else)\\b.*\\{|(?:cap(?:ture)?|qui(?:etly)?|noi(?:sily)?)\\s*\\{|\\{)",
      "end": "^\\s*(?:end\\s*;?\\s*$|\\}|\\*\\*#+\\s*endregion\\b)"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:cap(?:ture)?\\s+)?pr(?:ogram)?\\s+(?!(?:drop|dir|list)\\b).+|[^*\\n]*\\{)\\s*$",
    "decreaseIndentPattern": "^\\s*(?:end\\b|\\})"
  },
  "wordPattern": "\\$\\{[a-zA-Z_][a-zA-Z0-9_]*\\}|\\$[a-zA-Z_][a-zA-Z0-9_]*|`[a-zA-Z_][a-zA-Z0-9_]*\\x27|[a-zA-Z_][a-zA-Z0-9_]*"
}
